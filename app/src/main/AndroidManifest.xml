<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Normal permission, granted at install. This is how an MTZ's wallpapers are applied without
      root: device testing on HyperOS OS3.0.308.0 showed Xiaomi Themes holds no storage read
      permission at all (READ_MEDIA_IMAGES denied, READ_EXTERNAL_STORAGE appop "ignore"), so no
      file path can be handed to its ThemeService. WallpaperManager takes a stream instead.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--
      All-files access, requested on demand (never at launch). It is the only way to write a theme
      package into MIUI Backup's own folder (/sdcard/MIUI/backup/AllBackup), which is plain shared
      storage. Device testing on HyperOS OS3.0.301.0 showed this is the one rootless route that
      registers a third-party theme in Xiaomi Themes' catalogue: the system MIUI Backup app does the
      privileged restore itself. On Android 11+ a scoped-storage app cannot write there, so the user
      grants this in Settings only when they choose the MIUI Backup import path.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <queries>
        <intent>
            <action android:name="miui.intent.backup.LOCAL_HOME_ACTIVITY" />
        </intent>
        <package android:name="com.miui.backup" />
        <intent>
            <action android:name="rikka.shizuku.intent.action.REQUEST_BINDER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.lsposed.manager.LAUNCH_MANAGER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.matrix.vector.manager.LAUNCH_MANAGER" />
        </intent>
        <package android:name="org.lsposed.manager" />
        <package android:name="org.matrix.vector.manager" />
        <package android:name="com.android.thememanager" />
        <package android:name="com.software41.appshare" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.hamondev.shevery" />
        <package android:name="me.yuki.folk" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="io.github.vvb2060.magisk" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/xposed_module_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperOSMtzStudio">
        <!-- Recommended Xposed targets. This is intentionally editable manager metadata,
             not a libxposed static scope.list, so Vector/LSPosed must not lock the list. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_recommended_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UpdateInstallActivity"
            android:exported="false"
            android:theme="@style/Theme.HyperOSMtzStudio" />

        <service
            android:name=".AppUpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".ThemeTranslationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".CloudTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ThemePersistenceGuardService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors user-approved Xiaomi theme components through Shizuku and alerts when they are replaced" />
        </service>

        <receiver
            android:name=".RootlessRestoreBootReceiver"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
