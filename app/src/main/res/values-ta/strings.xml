    <string name="tm_device_not_found">ஆதரவு Xiaomi கருப்பொருள் மேலாளர் தொகுப்பு இல்லை</string>
    <string name="tm_btn_select_apk_version">%1$s APK ஐத் தேர்ந்தெடுக்கவும்</string>
    <string name="tm_verified_apk_info">APK: %1$s %2$s\nSHA-256: %3$s</string>
    <string name="tm_btn_downgrade_to_version">Root உடன் %1$s க்கு மாறவும்</string>
    <string name="tm_risk_checkbox">root மூலம் பழைய பதிப்பை நிறுவுவது தீம் மேலாளரை மறுதொடக்கம் செய்யலாம், மேலும் ROM நிறுவலை நிராகரிக்கலாம் என்பதைப் புரிந்துகொள்கிறேன்.</string>
    <string name="tm_dialog_title">தீம் மேலாளர் பதிப்பை மாற்றலாமா?</string>
    <string name="tm_dialog_text">சரிபார்க்கப்பட்ட %1$s தொகுப்பு மட்டுமே மாற்றப்படும். `pm install -r -d` கட்டளை root மூலம் இயங்கும்; இது கணினிக் கோப்புகளை எழுதாது அல்லது சரிபார்ப்பைத் தவிர்க்காது. செயல் தோல்வியடையலாம்; முதலில் தீம் அமைப்புகளைக் காப்புப்பிரதி எடுக்கவும்.</string>
    <string name="tm_dialog_confirm">உறுதிப்படுத்தவும் நிறைவேற்றவும்</string>
    <string name="tm_status_waiting_root">root அனுமதி மற்றும் தொகுப்பு மேலாளர் முடிவுக்காக காத்திருக்கிறேன்...</string>
    <string name="tm_status_root_failed">Root செயல்பாடு தோல்விஃ %1$s</string>
    <string name="shevery_dialog_title">Shizuku / Shevery</string>
    <string name="shevery_dialog_text">Shizuku/Shevery இயங்குகிறது. தொடர MTZ Studio அனுமதியை வழங்கவும். Root இல்லாத தீம் செயல்களுக்கு ADB பயன்முறை போதுமானது; root பயன்முறை root செய்யப்பட்ட சாதனங்களில் மட்டும் பயன்படுத்தப்படும்.</string>
    <string name="shevery_btn_grant">அனுமதி வழங்கல்</string>
    <string name="shevery_btn_skip">இப்போது தவிர்</string>
    <string name="privileged_access_permission_required">MTZ Studio என்ற பெயரில் Shizuku/Shevery என்ற பெயரில் அனுமதி வழங்கவும் அல்லது உங்கள் root மேலாளரில் சூப்பர் பயனர் அணுகலை வழங்கவும்.</string>
    <string name="privileged_access_adb_only">Shizuku/Shevery ADB பயன்முறையில் இயங்குகிறது. அதை root பயன்முறையில் தொடங்கவும் அல்லது உங்கள் root மேலாளரில் MTZ Studio சூப்பர் பயனர் அணுகலை வழங்கவும்.</string>
    <string name="privileged_access_unavailable">பயன்படுத்தக்கூடிய root சேனல் கிடைக்கவில்லை. Shizuku/Shevery ஐ root பயன்முறையில் தொடங்கவும் அல்லது உங்கள் root மேலாளரில் MTZ Studio சூப்பர் பயனர் அணுகலை வழங்கவும்.</string>
    <string name="status_privileged_access_required">அனுமதி தேவைஃ %1$s</string>
    <string name="privileged_dialog_title">Root அணுகல் தேவை</string>
    <string name="privileged_btn_retry">அணுகலை மறுபடியும் சரிபார்க்கவும்</string>
    <string name="privileged_permission_request_failed">அனுமதி கோரிக்கை அனுப்பப்படவில்லை. Shizuku/Shevery இயங்குகிறது என்பதை சரிபார்க்கவும், பின்னர் உங்கள் root மேலாளரில் MTZ Studio ஐ மீண்டும் முயற்சிக்கவும் அல்லது அங்கீகரிக்கவும்.</string>
    <string name="device_theme_import_title">கருப்பொருள்கள் மேலாளர் இருந்து கருப்பொருள்கள் இறக்குமதி</string>
    <string name="device_theme_import_desc">Xiaomi கருப்பொருள் மேலாளரிடமிருந்து உள்ளூர் MTZ கோப்புகளாக மீண்டும் பயன்படுத்தக்கூடிய கருப்பொருள்களைத் தேர்ந்தெடுத்து பிரித்தெடுக்கவும்.</string>
    <string name="device_theme_import_button">இறக்குமதி செய்ய கருப்பொருள்களைத் தேர்ந்தெடுக்கவும்</string>
    <string name="device_theme_select_dialog_title">இறக்குமதி செய்ய கருப்பொருள்களைத் தேர்ந்தெடுக்கவும்</string>
