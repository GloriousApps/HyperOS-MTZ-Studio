    <string name="error_restore_target">தேர்ந்தெடுக்கப்பட்ட காப்பு கோப்பை திறக்க முடியவில்லை</string>
    <string name="apply_dialog_title">கருப்பொருளை பயன்படுத்த?</string>
    <string name="apply_dialog_desc">%1$s உள்ளூர் கருப்பொருளாக கருப்பொருள் மேலாளருக்கு மாற்றப்பட்டு பயன்படுத்தப்படும். கருப்பொருள் கூறுகள் கணினி இடைமுகத்தை மறுதொடக்கம் செய்யலாம்.</string>
    <string name="status_preparing_apply">கருப்பொருள் மேலாளருக்கான தீம் தயாரித்தல்...</string>
    <string name="status_apply_success">%1$s கருப்பொருள் மேலாளருக்கு மாற்றப்பட்டு விண்ணப்பிக்கப்பட்டது</string>
    <string name="status_legacy_apply_unverified">சோதனையாளர் அழைப்பு %1$s என்று திரும்பியது. இந்த கருப்பொருள் மேலாளர் பதிப்பு ஒரு இறுதி பயன்பாட்டு முடிவு தெரிவிக்கவில்லை.</string>
