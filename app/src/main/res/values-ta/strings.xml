    <string name="status_apply_failed">பொருந்த முடியவில்லை பொருள்ஃ %1$s</string>
    <string name="status_modern_theme_imported">\"%1$s\"Xiaomi கருப்பொருள் மேலாளருக்கு சேர்க்கப்பட்டது</string>
    <string name="error_modern_bridge_failed">Xiaomi கருப்பொருள் மேலாளர் பாலம் செயல்பாட்டை முடிக்கவில்லை</string>
    <string name="modern_catalog_title">Xiaomi தீம் மேலாளர் நூலகம்</string>
    <string name="modern_catalog_desc">கருப்பொருள்கள், முன்னோட்டங்கள் மற்றும் செயல்கள் Xiaomi கருப்பொருள் மேலாளருடன் நேரடியாக ஒத்திசைக்கப்படுகின்றன.</string>
    <string name="modern_catalog_refresh">புதுப்பித்தல் பட்டியல்</string>
    <string name="modern_catalog_sync_summary">%1$d கருப்பொருள்கள் ஒத்திசைக்கப்பட்டன · %2$d ஆசிரியர் கேச் புதுப்பிப்புகள் · %3$d தோல்வியுற்றது</string>
    <string name="status_manual_import_ready">தானியங்கி 10.8 இறக்குமதி கிடைக்கவில்லை. MTZ தயாராக உள்ளது %1$s. கருப்பொருள்களில், இறக்குமதி என்பதைத் தட்டவும், இந்த கோப்பைத் தேர்ந்தெடுத்து, பின்னர் அதைப் பயன்படுத்தவும்.</string>
    <string name="manual_import_toast">கருப்பொருள் தானாக பயன்படுத்தப்படாவிட்டால், இறக்குமதி என்பதைத் தட்டவும் மற்றும் %1$s ஐத் தேர்ந்தெடுக்கவும்</string>
    <string name="diag_title">நேரடி கண்டறிதல்</string>
    <string name="diag_desc">தொடக்க, ஒத்திசைவு, கலவை, இறக்குமதி, பயன்படுத்துதல் மற்றும் நீக்குதல் படிகள் தானாகவே பதிவு செய்யப்படுகின்றன. சமீபத்திய 200 நிகழ்வுகள் முதலில் புதியதாகத் தோன்றும்; விரிவான பதிவுகளை ஏற்றுமதி செய்யலாம். பதிவுகள் இந்த சாதனத்தில் உள்ளன; மூல கோப்பு யுஆர்ஐக்கள் பதிவு செய்யப்படவில்லை.</string>
